{
 "name": "dsh-task-align",
 "version": "0.1.0",
 "description": "「任务对齐」：复杂任务开工前先复述它理解的目标与 3–5 步计划，等你确认后才动手（native 会话里确认前不放行任何工具），执行中显示做到第几步。PTC 会话可显示卡片，但无法强制拦截。Task alignment: restate the goal and a 3-5 step plan for approval before any tool runs, then show the current step.",
 "license": "MIT",
 "keywords": [
  "dsh",
  "dsh-plugin",
  "deepseek-harness",
  "task-alignment",
  "approval",
  "progress"
 ],
 "engines": {
  "dsh": ">=0.2.2-rc.5"
 },
 "type": "module",
 "exports": {
  ".": "./index.js",
  "./client": "./client.js",
  "./locale/*.json": "./locale/*.json",
  "./icon": "./icon.svg",
  "./skills": "./skills.js"
 },
 "files": [
  "index.js",
  "skills.js",
  "client.js",
  "cordis.patch.yml",
  "assets",
  "locale/*.json",
  "LICENSE",
  "README.md",
  "PUBLISHING.md",
  "icon.svg",
  "assets/icon-180.png"
 ],
 "dsh": {
  "bundle": {
   "patch": "./cordis.patch.yml"
  },
  "client": {
   "platform": "web",
   "inject": [
    "@deepseek-ai/dsh-client-ui-conversation"
   ]
  }
 }
}
